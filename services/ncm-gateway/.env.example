# Copy to .env for local development (npm run dev). On Render, set these as
# real environment variables / secrets in the dashboard instead -- .env is
# gitignored and should never be committed with real values.

NODE_ENV=development
PORT=3000

# Shared secret the ESP32 firmware sends as the X-Device-Key header.
# Required in production (server.js refuses to boot without it there).
# Generate something like: openssl rand -hex 32
DEVICE_API_KEY=change-me-to-a-real-secret

# Base URL of a separately deployed NeteaseCloudMusicApiEnhanced instance,
# no trailing slash. See README.md "Deploying the upstream NCM API" section.
NCM_UPSTREAM_URL=https://your-ncm-api-instance.example.com

# Optional: a logged-in NetEase account's cookie, forwarded to the upstream
# API for endpoints that need an authenticated session (e.g. some
# higher-bitrate resolves, personal playlists). Leave empty to run
# anonymous-only -- search, hot playlists, and standard-bitrate resolve for
# non-VIP tracks work without it. NEVER logged, NEVER sent to the device.
NCM_COOKIE=

NCM_UPSTREAM_TIMEOUT_MS=10000

# Hard product boundaries -- must stay false. config.js refuses to start if
# any of these is true. Do not change these to bypass login, VIP, or region
# restrictions; that is out of scope for this project.
ENABLE_GENERAL_UNBLOCK=false
ENABLE_RANDOM_CN_IP=false
ENABLE_PROXY=false
ENABLE_FLAC=false
SELECT_MAX_BR=false

RATE_LIMIT_METADATA_PER_MIN=60
RATE_LIMIT_RESOLVE_PER_MIN=20
