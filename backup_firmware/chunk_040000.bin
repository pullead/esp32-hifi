                                                                                       onmouseup="this.style.backgroundColor='#128F76'"
                                                                                       ontouchend="this.style.backgroundColor='#128F76'"
                                                                                       id="addName2" title="add BT Name to the table">+
                                                                                       </button></td>
                    </tr>
