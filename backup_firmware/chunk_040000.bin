            <td class="table_cell2"> MODE </td>
            <td> 25 </td>
            <td> <input type="text" class="boxstyle_s" id="ir_command_25" onclick="IRclick(25)" onkeyup="chIRcmd(25)" onchange="IRupdateJSON(25)"></td>
