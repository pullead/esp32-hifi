                    <tbody>
                    <tr>
                    <td> <input type="text" class="boxstyle_200x36" name="bt_scan_addr"> </td>
                    <td class="table_cell1"> <button class="button_20x36 buttongreen"  onclick="addScannedAddr(0)"
