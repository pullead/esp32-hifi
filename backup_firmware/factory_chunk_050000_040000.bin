            <td></td>
            <td></td>
            <td></td>
            </tr>

            <tr>
            <td> 8 </td>
            <td> <input type="text" class="boxstyle_s" id="ir_command_8" onclick="IRclick(8)" onkeyup="chIRcmd(8)" onchange="IRupdateJSON(8)"></td>
